# ============================================
# 觅途行 · MiTuXing 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================

# Django 配置
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL 数据库配置
MYSQL_DATABASE=travel_route_base
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# DeepSeek API 配置
# 请前往 https://platform.deepseek.com/ 获取 API Key
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 高德地图 Web 端 JS API Key（前端地图展示用）
# 请前往 https://lbs.amap.com/ 获取
gaodeMap=your-amap-web-js-key-here

# 高德地图 Web 服务 API Key（后端代理调用地理编码/路径规划，必须保密）
AMAP_SERVER_KEY=your-amap-server-key-here